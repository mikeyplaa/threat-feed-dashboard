# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit the real .env file.

# abuse.ch account key — covers both ThreatFox and URLhaus
# Register at https://abuse.ch/ then copy your API key from account settings
ABUSECH_API_KEY=

# Free account at https://otx.alienvault.com/
OTX_API_KEY=

# Free community key at https://app.crowdsec.net/ → CTI API
CROWDSEC_API_KEY=

# Free account at https://urlscan.io/ — unauthenticated search returns 403.
URLSCAN_API_KEY=

# Free account at https://www.virustotal.com/ (4 req/min on free tier)
VT_API_KEY=

# Free key at https://emailrep.io/ — the unauthenticated API is disabled,
# a key is required even for the free tier.
EMAILREP_API_KEY=
